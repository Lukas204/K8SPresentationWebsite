@startuml
!theme plain
skinparam componentStyle rectangle
skinparam backgroundColor #fcfcfc
skinparam Nodesep 60
skinparam Ranksep 50

' Colors & Styles
skinparam rectangle {
    BackgroundColor<<External>> #e1f5fe
    BackgroundColor<<Security>> #fff9c4
    BackgroundColor<<K8s>> #e3f2fd
    BackgroundColor<<App>> #ffffff
    BorderColor<<K8s>> #326CE5
}

header Kubernetes Presentation Handout Architecture
footer Stand: 2026

actor "Benutzer" as user #white

rectangle "Extern / Internet" <<External>> {
    [GitHub Repository] as git #white
}

rectangle "Cloudflare Security" <<Security>> {
    [Cloudflare Zero Trust] as cf
    [Cloudflare Tunnel] as tunnel
}

rectangle "Kubernetes Cluster" <<K8s>> {
    
    rectangle "Networking" {
        [Nginx Ingress] as ingress #white
        [App Service] as svc #white
    }

    rectangle "Application Pod" <<App>> {
        package "Containers" {
            [Node.js / React] as app #white
            [git-sync] as gitsync #white
        }
        storage "Shared Volume" as shared
    }

    rectangle "Database Tier" {
        database "MariaDB" as db #white
        storage "Persistent Volume" as pvc #white
    }
}

' Relations
user -down-> cf : HTTPS
cf -down-> tunnel : Tunneling
tunnel -down-> ingress : API Traffic

ingress -down-> svc
svc -down-> app : Round Robin

gitsync -up-> git : Watch & Pull
gitsync -down-> shared : Update Code
shared -up-> app : Serve Code

app -down-> db : Read/Write
db -down-> pvc : Data Persistence

note right of ingress
  <b>Rate Limit</b>
  5 Requests / s
  Burst: 10
end note

note right of gitsync
  <b>Auto-Update</b>
  Period: 60s
end note

@enduml
